{
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/health", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/ads-monitor", "destination": "/api/index" },
    { "source": "/ads-monitor/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/daily/content", "schedule": "30 3 * * *" },
    { "path": "/api/cron/daily/zalo", "schedule": "30 3 * * *" }
  ]
}
